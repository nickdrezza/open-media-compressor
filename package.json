{
    "name": "open-media-compressor",
    "version": "1.0.0",
    "description": "Ultra-minimalist browser-based media compressor",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "node --test tests/*.test.js",
