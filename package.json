{
    "name": "open-media-compressor",
    "version": "1.0.0",
    "description": "Ultra-minimalist browser-based media compressor",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "fixtures:generate": "node tests/fixtures/generate-fixtures.mjs",
        "test": "node --test tests/*.test.js",
        "test:e2e": "playwright test --project=chromium",
        "test:e2e:dev": "playwright test --project=chromium",
        "test:e2e:built": "npm run build && PLAYWRIGHT_MODE=built PLAYWRIGHT_RELEASE=1 playwright test --project=chromium",
        "test:e2e:webkit": "playwright test --project=webkit",
        "test:e2e:ui": "playwright test --ui",
        "test:ci": "npm run test && npm run test:e2e:dev && npm run test:e2e:built"
    },
    "dependencies": {
        "@ffmpeg/core": "^0.12.10",
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "alpinejs": "^3.13.3",
        "mediabunny": "^1.55.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "vite": "^8.2.1"
    }
}
