        "@ffmpeg/util": "^0.12.2",
        "alpinejs": "^3.13.3",
        "mediabunny": "^1.55.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "vite": "^8.2.1"
    }
}
